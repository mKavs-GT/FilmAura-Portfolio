{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix filmaura/FilmAura install",
  "buildCommand": "npm --prefix filmaura/FilmAura run build",
  "outputDirectory": "filmaura/FilmAura/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
