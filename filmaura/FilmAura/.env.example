# Optional API Keys for FilmAura
# If not provided, the application will automatically fall back to mock & sample data.

# TMDB API (The Movie Database) - https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# OMDb API - http://www.omdbapi.com/apikey.aspx
VITE_OMDB_API_KEY=

# CollectAPI (IMDb) - https://collectapi.com/
VITE_COLLECTAPI_KEY=

# Set to 'true' to force use of built-in mock data even if API keys are set
VITE_USE_MOCK_DATA=false
